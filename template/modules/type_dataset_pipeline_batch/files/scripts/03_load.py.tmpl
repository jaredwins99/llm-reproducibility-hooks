"""Load: write the transformed frame to its destination.

Orchestration only; functions live in src/. The validation is deliberate: a
load step that silently writes zero rows is the failure this stage prevents.

Chain:
    px.val    at least one row
    report    stage shape, printed before the write

Reads:  paths.transformed  Writes: paths.output
"""

import pandas as pd

from {{project_name_py}}.core.accessors import *  # noqa: F401,F403
from {{project_name_py}}.core.report import report
from {{project_name_py}}_study.config import load_config, output_path

config = load_config()

loaded = (pd.read_parquet(config["paths"]["transformed"])
          .px.val(lambda frame: len(frame) > 0, "the transform stage produced no rows"))

report("load", loaded)
loaded.to_csv(output_path(config, "output"), index=False)
