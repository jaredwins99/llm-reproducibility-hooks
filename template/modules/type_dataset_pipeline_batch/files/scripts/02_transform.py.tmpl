"""Transform: clean and reshape the extracted frame in one chain.

Orchestration only; functions live in src/. Every step takes a frame and
returns a frame, so the chain reads as the list of things that happen.

Chain:
    drop_blank_columns (library)     columns empty in every row
    normalise_whitespace (library)   strip text columns
    report                           stage shape, printed before the write

Reads:  paths.extracted  Writes: paths.transformed
"""

import pandas as pd

from {{project_name_py}}.core.accessors import *  # noqa: F401,F403
from {{project_name_py}}.core.report import report
from {{project_name_py}}.core.transforms import drop_blank_columns, normalise_whitespace
from {{project_name_py}}_study.config import load_config, output_path

config = load_config()

transformed = (pd.read_parquet(config["paths"]["extracted"])
               .pipe(drop_blank_columns)
               .px.log("after dropping blank columns")
               .pipe(normalise_whitespace))

report("transform", transformed)
transformed.to_parquet(output_path(config, "transformed"), compression="zstd", index=False)
