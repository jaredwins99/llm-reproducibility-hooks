"""Extract: the raw export named in config/study.yaml, staged as parquet.

Orchestration only; functions live in src/.

Chain:
    read_source (study)   raw export, every column as text
    px.log                shape after reading
    report                stage shape, printed before the write

Reads:  paths.raw        Writes: paths.extracted
"""

from {{project_name_py}}.core.accessors import *  # noqa: F401,F403
from {{project_name_py}}.core.report import report
from {{project_name_py}}_study.config import load_config, output_path
from {{project_name_py}}_study.sources import read_source

config = load_config()

extracted = (read_source(config["paths"]["raw"])
             .px.log("extracted"))

report("extract", extracted)
extracted.to_parquet(output_path(config, "extracted"), compression="zstd", index=False)
